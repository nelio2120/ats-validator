CREATE MEMORY TABLE PUBLIC.ADM_UBICACIONES_GEOGRAFICAS(CODIGO VARCHAR(30) PRIMARY KEY,DESCRIPCION VARCHAR(120),CODIGO_PADRE VARCHAR(30),NIVEL NUMERIC(2),ESTADO VARCHAR(3),UBICACION_COMPLETA VARCHAR(120))
CREATE MEMORY TABLE PUBLIC.RIG_CATALOGO_TIPO(CODIGO_CATALOGO_TIPO NUMERIC(19) PRIMARY KEY,CATALOGO_PADRE NUMERIC(19),NOMBRE_CATALOGO VARCHAR(250),EDITABLE VARCHAR(2),NEMONICO VARCHAR(20),FOREIGN KEY(CATALOGO_PADRE) REFERENCES PUBLIC.RIG_CATALOGO_TIPO(CODIGO_CATALOGO_TIPO),CONSTRAINT RCT_NMN_UK UNIQUE(NEMONICO))
CREATE MEMORY TABLE PUBLIC.RIG_CATALOGO_ANEXO(CODIGO_CATALOGO_TIPO NUMERIC(19),CODIGO_OPERATIVO VARCHAR(5))
CREATE MEMORY TABLE PUBLIC.RIG_DETALLE_CATALOGO(CODIGO_DETALLE_CATALOGO NUMERIC(19) PRIMARY KEY,CODIGO_CATALOGO_TIPO NUMERIC(19),NOMBRE_DETALLE_CATALOGO VARCHAR(250),VALOR_CATALOGO VARCHAR(100),FECHA_INCIO DATE,FECHA_FIN DATE,EDITABLE VARCHAR(2),ORDEN NUMERIC(10),ACTIVO CHARACTER(3) DEFAULT 'ACT' NOT NULL,VALOR_CATALOGO_NUMERICO NUMERIC(20))
CREATE MEMORY TABLE PUBLIC.ADM_PAISES(CODIGO VARCHAR(3),DESCRIPCION VARCHAR(30),CODIGO_PAIS_SUPER_BANCOS VARCHAR(2))
CREATE MEMORY TABLE PUBLIC.RIG_PAISES_SIN_PARAISO_FISCAL(CODIGO_PAISES_SIN_PARAISO_FISC VARCHAR(3),DESCRIPCION VARCHAR(30),ESTADO VARCHAR(3))
CREATE MEMORY TABLE PUBLIC.ADM_CONCEP_FORMULARIOS_ANEXOS(CODIGO_CONCEP_FORMUL_ANEX NUMERIC(15),CODIGO_CONCEPTO_FORMULARIO NUMERIC(6),CODIGO_FORMULARIO VARCHAR(2),CODIGO_FORMULARIO_GENERICO VARCHAR(8),NUMERO_CAMPO NUMERIC(12),NUMERO_CAMPO_ANEXO VARCHAR(10),MARCA_PORCENTAJE_LIBRE VARCHAR(1),NOMBRE_CAMPO VARCHAR(130),CONSTRAINT ACFA_PK PRIMARY KEY(CODIGO_CONCEP_FORMUL_ANEX))
CREATE INDEX CFA_NCF_NU_I ON PUBLIC.ADM_CONCEP_FORMULARIOS_ANEXOS(NUMERO_CAMPO)
CREATE UNIQUE INDEX ACFA_PK ON PUBLIC.ADM_CONCEP_FORMULARIOS_ANEXOS(CODIGO_CONCEP_FORMUL_ANEX)
CREATE MEMORY TABLE PUBLIC.ADM_CONCEPTOS_FORMULARIOS(CODIGO_CONCEPTO_FORMULARIO NUMERIC(6) NOT NULL,CODIGO_FORMULARIO VARCHAR(2) NOT NULL,DESCRIPCION_CONCEPTO VARCHAR(130) NOT NULL,ABREVIACION_CONCEPTO VARCHAR(32),TIPO_CAMPO VARCHAR(1) NOT NULL,CODIGO_CONCEPTO_FORMULARIO_P NUMERIC(6),OPERACION VARCHAR(10),JERARQUIA VARCHAR(30),CONSTRAINT CON_FOR_PK PRIMARY KEY(CODIGO_CONCEPTO_FORMULARIO,CODIGO_FORMULARIO))
CREATE UNIQUE INDEX CON_FOR_PK ON PUBLIC.ADM_CONCEPTOS_FORMULARIOS(CODIGO_CONCEPTO_FORMULARIO,CODIGO_FORMULARIO)
CREATE MEMORY TABLE PUBLIC.ADM_FORMULARIOS_CAMPOS_CONCEP(CODIGO_CONCEPTO_FORMULARIO NUMERIC(6) NOT NULL,NUMERO_CAMPO NUMERIC(12) NOT NULL,CODIGO_FORMULARIO VARCHAR(2) NOT NULL,CODIGO_FORMULARIO_GENERICO VARCHAR(8) NOT NULL,CODIGO_FORMULARIO_UNICO VARCHAR(8),CONSTRAINT FOR_CAM_CON1_PK PRIMARY KEY(NUMERO_CAMPO,CODIGO_FORMULARIO,CODIGO_CONCEPTO_FORMULARIO,CODIGO_FORMULARIO_GENERICO))
CREATE MEMORY TABLE PUBLIC.ADM_PORCENT_FORMUL_CAMP_CONCEP(CODIGO_PORCENT_CAMPO_FORMUL NUMERIC(10) NOT NULL,CODIGO_CONCEPTO_FORMULARIO NUMERIC(6) NOT NULL,CODIGO_FORMULARIO VARCHAR(2) NOT NULL,CODIGO_FORMULARIO_GENERICO VARCHAR(8) NOT NULL,NUMERO_CAMPO NUMERIC(12) NOT NULL,PORCENTAJE NUMERIC(5,2) NOT NULL,FECHA_INICIO_VIGENCIA DATE NOT NULL,FECHA_FIN_VIGENCIA DATE,LIMITE_INFERIOR NUMERIC(5,2),CONSTRAINT APFA_PK PRIMARY KEY(CODIGO_PORCENT_CAMPO_FORMUL))
CREATE MEMORY TABLE PUBLIC.IVA_SECUENCIALES_TRANSACCIONES(CODIGO_SECUENC_TRANS VARCHAR(2),CODIGO_TIPO_TRANSACCION VARCHAR(2),CODIGO_IDENTIFICACION VARCHAR(1))
CREATE MEMORY TABLE PUBLIC.IVA_COMPROBANTES_TRANSACCIONES("CODIGO_TIPO_COMPROBANTE" VARCHAR(4),"CODIGO_SECUENC_TRANS" VARCHAR(2),"ESTADO" VARCHAR(1),"CODIGO_COMPROBANTE_TRANSACCION" NUMERIC(7),FECHA_DESDE DATE,FECHA_HASTA DATE,CONSTRAINT COT_PK PRIMARY KEY("CODIGO_COMPROBANTE_TRANSACCION"))
CREATE MEMORY TABLE PUBLIC.IVA_SECUENCIALES_COMPROBANTES("CODIGO_SECUENC_COMPRO" VARCHAR(3),"CODIGO_TIPO_COMPROBANTE" VARCHAR(4),"CODIGO_CREDITO_TRIBUTARIO" VARCHAR(3),"ESTADO" VARCHAR(1),FECHA_DESDE DATE,FECHA_HASTA DATE,CONSTRAINT SCO_PK PRIMARY KEY("CODIGO_SECUENC_COMPRO"))
CREATE MEMORY TABLE PUBLIC.ADM_TIPOS_DOCUMENTOS_ANIO("CODIGO_TIPO_DOCUMENTO_ANIO" NUMERIC(5),"CODIGO_TIPO_DOCUMENTO" NUMERIC(4),"FECHA_VALIDEZ_DOCUMENTO" DATE,CONSTRAINT "ATDA_PK" PRIMARY KEY("CODIGO_TIPO_DOCUMENTO_ANIO"))
CREATE MEMORY TABLE PUBLIC."CAE_VIW_REGIMENES"("CODIGO_REGIMEN" VARCHAR(11),"NOMBRE_REGIMEN" VARCHAR(200),"IMPORTACION" CHARACTER(1),"EXPORTACION" VARCHAR(1))
CREATE MEMORY TABLE PUBLIC.ADM_TIPOS_DOCUMENTOS(CODIGO NUMERIC(4) NOT NULL,DESCRIPCION VARCHAR(80) NOT NULL,ABREVIACION VARCHAR(15),ACTIVO CHARACTER(1) DEFAULT 'S' NOT NULL,CREDITO_TRIBUTARIO VARCHAR(1),VISUALIZAR CHARACTER(1),IMAGEN BLOB(16M),CODIGO_SUB_GRUPO_DOCUMENTAL NUMERIC(10),CONSTRAINT TDO_PK PRIMARY KEY(CODIGO))
CREATE MEMORY TABLE PUBLIC.IVA_CREDITOS_TRIBUTARIOS(CODIGO_CREDITO_TRIBUTARIO VARCHAR(3) NOT NULL,DESCRIPCION VARCHAR(150) NOT NULL,ESTADO VARCHAR(1),CONSTRAINT CTR_PK PRIMARY KEY(CODIGO_CREDITO_TRIBUTARIO))
CREATE MEMORY TABLE PUBLIC.CAE_VIW_DISTRITOS_ADUANEROS(CODIGO_DISTRITO_ADUANERO VARCHAR(4),NOMBRE_DISTRITO_ADUANERO VARCHAR(80))
CREATE MEMORY TABLE PUBLIC.CAE_VIW_REGIMENES_VIGENCIA(CODIGO_REGIMEN VARCHAR(3),FECHA_DESDE DATE,FECHA_HASTA DATE)
CREATE MEMORY TABLE PUBLIC.ADU_VIW_REGIMEN_ADUANERO(CODIGO_REGIMEN_ECUAPASS CHARACTER(1),CODIGO_REGIMEN VARCHAR(10),DESCRIPCION_REGIMEN VARCHAR(200),TIPO_REGIMEN VARCHAR(200),OBSERVACION_TRATAMIENTO_OPERAD VARCHAR(110),CODIGO_REGIMEN_SICE VARCHAR(11),DESCRIPCION_REGIMEN_SICE VARCHAR(80))
CREATE MEMORY TABLE PUBLIC.RIG_IVA_RETENCION_DIVIDENDOS(CODIGO_IVA_RETENCION_DIVIDENDO NUMERIC(38),FRACCION_BASICA NUMERIC(14,2),EXCESO_HASTA NUMERIC(14,2) NOT NULL,RETENCION_FRACCION_BASICA NUMERIC(14,2) NOT NULL,PORCENTAJE_RETENCION NUMERIC(5,2) NOT NULL,FECHA_DESDE DATE,FECHA_HASTA DATE)
CREATE MEMORY TABLE PUBLIC.RIG_PARAM_TARIFA_RET_BANANO(CODIGO_PARAM_TARIFA_RET_BANANO NUMERIC(10) NOT NULL,TARIFA NUMERIC(6,3) NOT NULL,NUMERO_MINIMO_CAJA NUMERIC(10),NUMERO_MAXIMO_CAJA NUMERIC(10),NUMERO_CAMPO VARCHAR(4) NOT NULL,ESTADO VARCHAR(3))
CREATE MEMORY TABLE PUBLIC.RIG_IVA_SUSTENTO_TRANSACCION(CODIGO_IVA_SUSTENTO_TRANS NUMERIC(38) NOT NULL,CODIGO_CREDITO_TRIBUTARIO VARCHAR(3) NOT NULL,CODIGO_COMPROBANTE_TRANSACCION NUMERIC(38) NOT NULL,ESTADO VARCHAR(1) NOT NULL,FECHA_DESDE DATE,FECHA_HASTA DATE)
CREATE MEMORY TABLE PUBLIC.VAL_CAMPOS_FORMULARIOS(CODIGO_CAMPO_FORMULARIO NUMERIC(128) NOT NULL,CODIGO_FORMULARIO VARCHAR(10) NOT NULL,CODIGO_VERSION_FORMULARIO VARCHAR(16) NOT NULL,NUMERO_CAMPO_FORMULARIO NUMERIC(5) NOT NULL,TIPO_CAMPO_FORMULARIO VARCHAR(1) NOT NULL,DESCRIPCION_CAMPO_FORMULARIO VARCHAR(1000) NOT NULL)
CREATE MEMORY TABLE PUBLIC.RIG_ATS_PARAISO_FISCAL(CODIGO_ATS_PARAISO_FISCAL NUMERIC(128) NOT NULL,CODIGO_PAIS NUMERIC(128),IDENTIFICADOR_PARAISO_FISCAL NUMERIC(128),NOMBRE_PARAISO_FISCAL VARCHAR(200),FECHA_INICIO DATE,FECHA_FIN DATE)
CREATE MEMORY TABLE PUBLIC.RIG_MID_MONEDA(CODIGO_MID_MONEDA NUMERIC(4) NOT NULL,MONEDA_SUPER_BANCOS VARCHAR(3) NOT NULL,DESCRIPCION VARCHAR(250) NOT NULL,FECHA_INCIO DATE NOT NULL,FECHA_FIN DATE)
CREATE MEMORY TABLE PUBLIC.RIG_RTF_PRODUCTO_FINANCIERO(CODIGO_RIG_RTF_PRODUCTO_FINAC NUMERIC(5) NOT NULL,CODIGO_PRODUCTO_FINANCIERO VARCHAR(3) NOT NULL,DESCRIPCION_PRODUCTO VARCHAR(200),FECHA_INICIO DATE NOT NULL,FECHA_FIN DATE)
CREATE MEMORY TABLE PUBLIC.RIG_RTF_DETALLE_TIPO_OPERACION(CODIGO_DETALE_TIPO_OP NUMERIC(38) NOT NULL,CODIGO_RIG_RTF_PRODUCTO_FINAC NUMERIC(5),CODIGO_TIPO_OP_FINANCIERA NUMERIC(6),CODIGO_OPERACION VARCHAR(5))
CREATE MEMORY TABLE PUBLIC.RIG_APS_FIGURA_JURIDICA(CODIGO_APS_FIGURA_JURIDICA INTEGER NOT NULL,CODIGO_PAIS INTEGER,IDENTIFICADOR_FIGURA_JURIDICA INTEGER,NOMBRE_FIGURA_JURIDICA VARCHAR(200),FECHA_INICIO DATE,FECHA_FIN DATE)
