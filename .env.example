# ============================================================================
# Archivo de ejemplo de variables de entorno para ATS Validator
# Copiar a .env para uso con docker-compose
# ============================================================================

# Puerto del host donde se expondrá el servicio
# Default: 8080
HOST_PORT=8080

# Opciones de JVM
# Formato: -Xms<inicial> -Xmx<máximo>
# Default: -Xms256m -Xmx1024m
JAVA_OPTS=-Xms256m -Xmx1024m

# Puerto interno del servidor (normalmente no cambiar)
# Default: 8080
SERVER_PORT=8080

# Límites de CPU (núcleos)
# Default: 2
CPU_LIMIT=2

# Límite de memoria del contenedor
# Default: 1536M
MEMORY_LIMIT=1536M

# Memoria reservada (mínima)
# Default: 512M
MEMORY_RESERVATION=512M
